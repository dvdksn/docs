---
/**
 * GordonChat — Q&A chat mounted in the right-side slide-out panel.
 *
 * Conversation state is persisted via sessionStorage so conversations
 * survive navigation between pages.
 *
 * Aesthetic: docs-native Q&A, not a chat app.
 *   - No bubbles. User turn = italic display-weight line. Assistant
 *     turn = reading prose using the site's typography.
 *   - No mascot. No blue header bar. Hairlines, OKLCH tokens.
 *   - Suggestions are plain-text hairline chips.
 */
---

<div
  id="gordon-chat"
  class="gordon-chat"
  aria-label="Gordon AI Chat"
>
  <header class="g-topbar">
    <span class="g-brand">
      <span class="g-mark g-mark--sm" aria-hidden="true"></span>
      <span>Gordon</span>
    </span>
    <div class="g-topbar-actions">
      <button
        type="button"
        id="gordon-new-chat-btn"
        class="g-iconbtn"
        title="Clear conversation"
        aria-label="Clear conversation"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
      </button>
      <button
        type="button"
        id="gordon-close-btn"
        class="g-iconbtn"
        title="Close"
        aria-label="Close"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </header>

  <div class="g-messages" id="gordon-messages">
    <div class="g-welcome" id="gordon-welcome">
      <div class="g-welcome-mark" aria-hidden="true">
        <span class="g-mark g-mark--lg"></span>
      </div>
      <h2 class="g-welcome-title">Ask Gordon.</h2>
      <p class="g-welcome-lede">
        Docker's AI assistant, grounded in the documentation.
        Ten questions per thread &mdash; make them count.
      </p>
      <p class="d-micro g-try-label">Try asking</p>
      <div class="g-suggestions" id="gordon-suggestions">
        <button type="button" class="g-suggestion" data-query="Help me get started with Docker. What should I do first?">
          Getting started with Docker
        </button>
        <button type="button" class="g-suggestion" data-query="How do Docker Hardened Images work?">
          How Hardened Images work
        </button>
        <button type="button" class="g-suggestion" data-query="What is the difference between docker run and docker exec?">
          docker run vs docker exec
        </button>
        <button type="button" class="g-suggestion" data-query="How do I isolate an AI agent inside a sandbox?">
          Isolate an AI agent in a sandbox
        </button>
      </div>
    </div>
  </div>

  <form class="g-input-area" id="gordon-input-form" autocomplete="off">
    <textarea
      id="gordon-input"
      placeholder="Ask about any Docker product…"
      rows="2"
      aria-label="Ask Gordon"
    ></textarea>
    <div class="g-input-foot">
      <span class="g-input-hint" aria-hidden="true">
        <kbd>⇧</kbd><kbd>↵</kbd><span>for a new line</span>
      </span>
      <button type="submit" class="g-send" id="gordon-send-btn" aria-label="Send" disabled>
        <span>Ask</span>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </form>

  <p class="g-disclaimer">
    <span>Answers generated from the documentation.</span>
    <a href="https://github.com/docker/docs/issues/23966" target="_blank" rel="noopener noreferrer">Share feedback</a>
  </p>
</div>

<script>
  import { marked } from 'marked';
  import hljs from 'highlight.js/lib/core';
  import bash from 'highlight.js/lib/languages/bash';
  import javascript from 'highlight.js/lib/languages/javascript';
  import typescript from 'highlight.js/lib/languages/typescript';
  import json from 'highlight.js/lib/languages/json';
  import yaml from 'highlight.js/lib/languages/yaml';
  import xml from 'highlight.js/lib/languages/xml';
  import css from 'highlight.js/lib/languages/css';
  import python from 'highlight.js/lib/languages/python';
  import go from 'highlight.js/lib/languages/go';
  import dockerfile from 'highlight.js/lib/languages/dockerfile';
  import plaintext from 'highlight.js/lib/languages/plaintext';

  hljs.registerLanguage('bash', bash);
  hljs.registerLanguage('sh', bash);
  hljs.registerLanguage('shell', bash);
  hljs.registerLanguage('javascript', javascript);
  hljs.registerLanguage('js', javascript);
  hljs.registerLanguage('typescript', typescript);
  hljs.registerLanguage('ts', typescript);
  hljs.registerLanguage('json', json);
  hljs.registerLanguage('yaml', yaml);
  hljs.registerLanguage('yml', yaml);
  hljs.registerLanguage('xml', xml);
  hljs.registerLanguage('html', xml);
  hljs.registerLanguage('css', css);
  hljs.registerLanguage('python', python);
  hljs.registerLanguage('py', python);
  hljs.registerLanguage('go', go);
  hljs.registerLanguage('golang', go);
  hljs.registerLanguage('dockerfile', dockerfile);
  hljs.registerLanguage('docker', dockerfile);
  hljs.registerLanguage('plaintext', plaintext);
  hljs.registerLanguage('text', plaintext);

  const MAX_TURNS = 10;
  const BASE_URL =
    import.meta.env.PUBLIC_GORDON_BASE_URL ||
    'https://ai-backend-service-stage.docker.com';

  interface ChatMessage {
    role: 'user' | 'assistant';
    content: string;
    isStreaming?: boolean;
    qaId?: string;
    feedback?: 'positive' | 'negative' | null;
  }

  // ── DOM ──
  const rootEl = document.getElementById('gordon-chat');
  if (rootEl) {
    const messagesEl = document.getElementById('gordon-messages')!;
    const welcomeEl = document.getElementById('gordon-welcome')!;
    const inputForm = document.getElementById(
      'gordon-input-form',
    ) as HTMLFormElement;
    const inputEl = document.getElementById(
      'gordon-input',
    ) as HTMLTextAreaElement;
    const sendBtn = document.getElementById(
      'gordon-send-btn',
    ) as HTMLButtonElement;
    const suggestionsEl = document.getElementById('gordon-suggestions')!;
    const closeBtn = document.getElementById('gordon-close-btn')!;
    const newChatBtn = document.getElementById('gordon-new-chat-btn')!;

    // ── State ──
    let messages: ChatMessage[] = [];
    let threadId: string | null = null;
    let isLoading = false;

    function loadState() {
      try {
        const m = sessionStorage.getItem('gordon-messages');
        if (m) {
          messages = JSON.parse(m).filter(
            (msg: ChatMessage) => !msg.isStreaming,
          );
        }
        threadId = sessionStorage.getItem('gordon-threadId');
      } catch {}
    }

    function saveState() {
      try {
        sessionStorage.setItem('gordon-messages', JSON.stringify(messages));
        if (threadId) sessionStorage.setItem('gordon-threadId', threadId);
        else sessionStorage.removeItem('gordon-threadId');
      } catch {}
    }

    function getSessionId(): string {
      let id = sessionStorage.getItem('gordon-session-id');
      if (!id) {
        id = `docs-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
        sessionStorage.setItem('gordon-session-id', id);
      }
      return id;
    }

    // ── Markdown ──
    marked.use({
      breaks: true,
      gfm: true,
      renderer: {
        code({ text, lang }: { text: string; lang?: string }) {
          const language = lang && hljs.getLanguage(lang) ? lang : null;
          const body = language
            ? hljs.highlight(text, { language }).value
            : escapeHtml(text);
          const label = (language || 'text').toUpperCase();
          return `<pre class="g-pre" data-lang="${label}"><code class="hljs">${body}</code></pre>`;
        },
      },
    });

    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    // ── Panel toggle ──
    function closePanel() {
      document.documentElement.removeAttribute('data-chat-open');
    }
    function togglePanel() {
      if (document.documentElement.hasAttribute('data-chat-open')) {
        closePanel();
      } else {
        document.documentElement.setAttribute('data-chat-open', '');
        setTimeout(() => inputEl.focus(), 260);
      }
    }

    window.addEventListener('toggle-ask-ai', togglePanel);
    // Opens the panel AND seeds it with a query (from home hero input, etc.).
    window.addEventListener('ask-ai', ((e: CustomEvent<{ query?: string }>) => {
      const q = (e.detail?.query || '').trim();
      if (!document.documentElement.hasAttribute('data-chat-open')) {
        document.documentElement.setAttribute('data-chat-open', '');
      }
      if (q) {
        // Wait for the panel's opening animation so the focus+scroll settle,
        // then send. Mirrors the 260ms delay used by togglePanel.
        setTimeout(() => { if (!isLoading) sendMessage(q); }, 260);
      } else {
        setTimeout(() => inputEl.focus(), 260);
      }
    }) as EventListener);
    closeBtn.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (
        e.key === 'Escape' &&
        document.documentElement.hasAttribute('data-chat-open')
      ) {
        closePanel();
      }
    });

    // ── New chat ──
    newChatBtn.addEventListener('click', () => {
      if (messages.length === 0) return;
      if (!confirm('Clear this conversation?')) return;
      messages = [];
      threadId = null;
      saveState();
      renderMessages();
    });

    // ── Render ──
    function renderMessages() {
      messagesEl
        .querySelectorAll('.g-turn, .g-warn')
        .forEach((el) => el.remove());

      if (messages.length === 0) {
        welcomeEl.style.display = '';
        return;
      }
      welcomeEl.style.display = 'none';

      for (let i = 0; i < messages.length; i++) {
        appendTurn(messages[i], i);
      }

      const userTurns = messages.filter((m) => m.role === 'user').length;
      const remaining = MAX_TURNS - userTurns;

      if (userTurns >= MAX_TURNS) {
        const warn = document.createElement('div');
        warn.className = 'g-warn g-warn--limit';
        warn.innerHTML = `
          <p>You've reached the ${MAX_TURNS}-question limit for this thread. Start a new one for the next question.</p>
          <button type="button" class="g-action" id="g-new-thread">Start a new thread</button>
        `;
        messagesEl.appendChild(warn);
        warn.querySelector('#g-new-thread')?.addEventListener('click', () => {
          messages = [];
          threadId = null;
          saveState();
          renderMessages();
        });
        inputEl.disabled = true;
      } else if (remaining <= 3) {
        const warn = document.createElement('div');
        warn.className = 'g-warn g-warn--countdown';
        warn.textContent = `${remaining} question${remaining === 1 ? '' : 's'} left in this thread.`;
        messagesEl.appendChild(warn);
        inputEl.disabled = false;
      } else {
        inputEl.disabled = false;
      }

      scrollToBottom();
    }

    function appendTurn(msg: ChatMessage, index: number) {
      const turn = document.createElement('div');
      turn.className = `g-turn g-turn--${msg.role}`;

      if (msg.role === 'user') {
        const body = document.createElement('p');
        body.className = 'g-user-body';
        body.textContent = msg.content;
        turn.appendChild(body);
      } else {
        const label = document.createElement('p');
        label.className = 'd-micro g-turn-label';
        label.innerHTML = `
          <span class="g-mark g-mark--xs" aria-hidden="true"></span>
          <span>Gordon</span>
        `;
        turn.appendChild(label);

        const body = document.createElement('div');
        body.className = 'g-assistant-body';
        if (msg.isStreaming && !msg.content) {
          body.innerHTML = '<div class="g-dots"><span></span><span></span><span></span></div>';
        } else {
          body.innerHTML = marked.parse(msg.content) as string;
        }
        turn.appendChild(body);

        if (!msg.isStreaming && msg.content) {
          const actions = document.createElement('div');
          actions.className = 'g-actions';
          const svgUp = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>`;
          const svgDown = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/></svg>`;
          const svgCopy = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
          actions.innerHTML = `
            <span class="g-actions-label">Was this helpful?</span>
            <button type="button" class="g-action g-action--icon g-action--up ${msg.feedback === 'positive' ? 'is-active' : ''}" aria-label="Mark helpful" title="Helpful">${svgUp}</button>
            <button type="button" class="g-action g-action--icon g-action--down ${msg.feedback === 'negative' ? 'is-active' : ''}" aria-label="Mark not helpful" title="Not quite">${svgDown}</button>
            <button type="button" class="g-action g-action--copy" aria-label="Copy answer">${svgCopy}<span>Copy</span></button>
          `;
          turn.appendChild(actions);

          const upBtn = actions.querySelector<HTMLButtonElement>('.g-action--up')!;
          const downBtn = actions.querySelector<HTMLButtonElement>('.g-action--down')!;
          const copyBtn = actions.querySelector<HTMLButtonElement>('.g-action--copy')!;
          const copyLabel = copyBtn.querySelector('span')!;

          upBtn.addEventListener('click', () =>
            submitFeedback(index, 'positive', upBtn, downBtn),
          );
          downBtn.addEventListener('click', () =>
            submitFeedback(index, 'negative', upBtn, downBtn),
          );
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(msg.content).then(() => {
              copyLabel.textContent = 'Copied';
              setTimeout(() => (copyLabel.textContent = 'Copy'), 2000);
            });
          });
        }
      }

      messagesEl.appendChild(turn);
    }

    function scrollToBottom() {
      messagesEl.scrollTo({
        top: messagesEl.scrollHeight,
        behavior: 'smooth',
      });
    }

    // ── Suggestions ──
    suggestionsEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest(
        '.g-suggestion',
      ) as HTMLElement | null;
      if (btn) sendMessage(btn.getAttribute('data-query') || '');
    });

    // ── Input autosize + submit ──
    function autosize() {
      inputEl.style.height = 'auto';
      inputEl.style.height = Math.min(160, inputEl.scrollHeight) + 'px';
    }

    inputEl.addEventListener('input', () => {
      autosize();
      sendBtn.disabled = !inputEl.value.trim();
    });

    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const text = inputEl.value.trim();
        if (text && !isLoading) sendMessage(text);
      }
    });

    inputForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = inputEl.value.trim();
      if (text && !isLoading) sendMessage(text);
    });

    // ── Send ──
    async function sendMessage(content: string) {
      const userTurns = messages.filter((m) => m.role === 'user').length;
      if (userTurns >= MAX_TURNS || isLoading) return;

      messages.push({ role: 'user', content });
      saveState();

      inputEl.value = '';
      inputEl.style.height = 'auto';
      sendBtn.disabled = true;

      const respIdx = messages.length;
      messages.push({
        role: 'assistant',
        content: '',
        isStreaming: true,
        qaId: undefined,
        feedback: null,
      });

      renderMessages();
      isLoading = true;
      inputEl.disabled = true;
      sendBtn.classList.add('is-loading');

      const apiMessages = messages.slice(0, respIdx).map((m, i) => {
        const base: any = { role: m.role, content: m.content };
        if (i === respIdx - 1) {
          base.copilot_references = [
            {
              data: {
                origin: 'docs-website',
                email: 'docs@docker.com',
                uuid: getSessionId(),
                action: 'AskGordon',
                page_url: window.location.href,
                page_title: document.title,
              },
            },
          ];
        }
        return base;
      });

      try {
        const body: any = { messages: apiMessages };
        if (threadId) body.thread_uuid = threadId;

        const resp = await fetch(`${BASE_URL}/public/ask`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (!resp.ok) {
          if (resp.status === 429) throw new Error('RATE_LIMIT_EXCEEDED');
          throw new Error(`HTTP ${resp.status}`);
        }

        const reader = resp.body!.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        const isNewConversation = !threadId;

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() || '';

          for (const line of lines) {
            if (!line.startsWith('data: ')) continue;
            const data = line.slice(6).trim();
            if (data === '[DONE]') continue;
            try {
              const parsed = JSON.parse(data);
              if (parsed.thread_id) {
                if (isNewConversation) threadId = parsed.thread_id;
                continue;
              }
              if (parsed.question_answer_id) {
                messages[respIdx].qaId = parsed.question_answer_id;
                continue;
              }
              if (parsed.choices?.[0]?.delta?.content) {
                messages[respIdx].content +=
                  parsed.choices[0].delta.content;
                const turns = messagesEl.querySelectorAll(
                  '.g-turn--assistant',
                );
                const lastTurn = turns[turns.length - 1];
                if (lastTurn) {
                  const body = lastTurn.querySelector('.g-assistant-body');
                  if (body) {
                    const dots = body.querySelector('.g-dots');
                    if (dots) dots.remove();
                    body.innerHTML = marked.parse(
                      messages[respIdx].content,
                    ) as string;
                  }
                }
                const near =
                  messagesEl.scrollHeight -
                    messagesEl.scrollTop -
                    messagesEl.clientHeight <
                  120;
                if (near) messagesEl.scrollTop = messagesEl.scrollHeight;
              }
            } catch {}
          }
        }
      } catch (err: any) {
        if (err?.message === 'RATE_LIMIT_EXCEEDED') {
          messages.splice(respIdx, 1);
          const warn = document.createElement('div');
          warn.className = 'g-warn g-warn--limit';
          warn.textContent = 'Rate limit reached. Please try again in a moment.';
          messagesEl.appendChild(warn);
        } else {
          messages[respIdx].content =
            messages[respIdx].content ||
            'Failed to get a response. Please try again.';
        }
      }

      if (messages[respIdx]) messages[respIdx].isStreaming = false;
      isLoading = false;
      inputEl.disabled = false;
      sendBtn.classList.remove('is-loading');
      sendBtn.disabled = !inputEl.value.trim();
      saveState();
      renderMessages();
    }

    // ── Feedback ──
    async function submitFeedback(
      idx: number,
      type: 'positive' | 'negative',
      upEl: HTMLElement,
      downEl: HTMLElement,
    ) {
      const msg = messages[idx];
      if (!msg?.qaId || msg.feedback === type) return;
      msg.feedback = type;
      saveState();

      upEl.classList.toggle('is-active', type === 'positive');
      downEl.classList.toggle('is-active', type === 'negative');

      try {
        await fetch(`${BASE_URL}/feedback`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: msg.qaId, feedback: type }),
        });
      } catch {}
    }

    // ── Init ──
    loadState();
    renderMessages();
    autosize();
  }
</script>

<style is:global>
  /* All selectors are `.g-*` prefixed — safe to hoist global
     because chat messages are rendered via innerHTML at runtime
     and Astro's scoped styles only match template markup. */
  /* ══════════════════════════════════════════════════════════
   *  Chat layout — sits inside the slide-out panel,
   *  fills its height, scrolls messages internally.
   * ══════════════════════════════════════════════════════════ */
  .gordon-chat {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--d-surface);
    font-family: var(--sl-font);
    color: var(--d-text);
  }

  .g-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem 0.85rem 1.5rem;
    border-bottom: 1px solid var(--d-border);
    flex-shrink: 0;
  }

  .g-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: var(--d-track-mono);
    color: var(--d-text-strong);
  }
  .g-brand .g-mark {
    color: var(--d-accent);
  }

  /* Shared Gordon mask-image icon. `currentColor` tints it. */
  .g-mark {
    display: inline-block;
    background: currentColor;
    -webkit-mask: url(/icons/gordon.svg) no-repeat center / contain;
    mask: url(/icons/gordon.svg) no-repeat center / contain;
  }
  .g-mark--xs { width: 0.85rem; height: 0.85rem; }
  .g-mark--sm { width: 1.1rem; height: 1.1rem; }
  .g-mark--lg { width: 1.5rem; height: 1.5rem; }

  .g-topbar-actions { display: inline-flex; gap: 0.25rem; }

  .g-iconbtn {
    -webkit-appearance: none;
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--d-text-muted);
    cursor: pointer;
    box-shadow: none;
    border-radius: var(--d-radius-sm);
    transition: color 0.15s, background 0.15s;
  }
  .g-iconbtn:hover,
  .g-iconbtn:focus-visible {
    color: var(--d-accent);
    background: var(--d-surface-sunk);
  }

  /* ══════════════════════════════════════════════════════════
   *  Messages container
   * ══════════════════════════════════════════════════════════ */
  .g-messages {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 1.5rem 1.5rem 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--d-border-strong) transparent;
  }

  /* ══════════════════════════════════════════════════════════
   *  Welcome / empty state
   * ══════════════════════════════════════════════════════════ */
  .g-welcome {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
  }

  .g-welcome-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border: 1px solid var(--d-border);
    border-radius: var(--d-radius-md);
    color: var(--d-accent);
