---
---

<div class="ask-ai-container" id="ask-ai-panel">
  <div class="ask-ai-header">
    <span class="ask-ai-title">&gt; ask-ai</span>
    <div class="ask-ai-header-actions">
      <button class="ask-ai-btn" id="ask-ai-clear-btn" title="Clear chat">[clear]</button>
      <button class="ask-ai-btn" id="ask-ai-close-btn" title="Close">[x]</button>
    </div>
  </div>

  <div class="ask-ai-messages" id="ask-ai-messages">
    <div class="ask-ai-welcome" id="ask-ai-welcome">
      <p class="ask-ai-welcome-text">Ask anything about Kaname and Docker sandboxes.</p>
      <div class="ask-ai-suggestions" id="ask-ai-suggestions">
        <button class="ask-ai-suggestion" data-query="What is Kaname?"># What is Kaname?</button>
        <button class="ask-ai-suggestion" data-query="How do I create a sandbox?"># How do I create a sandbox?</button>
        <button class="ask-ai-suggestion" data-query="What agents are supported?"># What agents are supported?</button>
        <button class="ask-ai-suggestion" data-query="How does network isolation work?"># How does network isolation work?</button>
      </div>
    </div>

    <div class="ask-ai-turns-warning" id="ask-ai-turns-warning"></div>

    <form class="ask-ai-input-form" id="ask-ai-input-form">
      <span class="ask-ai-prompt-symbol">$</span>
      <textarea
        class="ask-ai-input"
        id="ask-ai-input"
        placeholder="ask a question..."
        autocomplete="off"
        rows="1"
      ></textarea>
    </form>
  </div>
</div>

<script>
  import { marked } from 'marked';
  import hljs from 'highlight.js/lib/core';
  import bash from 'highlight.js/lib/languages/bash';
  import javascript from 'highlight.js/lib/languages/javascript';
  import typescript from 'highlight.js/lib/languages/typescript';
  import json from 'highlight.js/lib/languages/json';
  import yaml from 'highlight.js/lib/languages/yaml';
  import xml from 'highlight.js/lib/languages/xml';
  import css from 'highlight.js/lib/languages/css';
  import python from 'highlight.js/lib/languages/python';
  import go from 'highlight.js/lib/languages/go';
  import dockerfile from 'highlight.js/lib/languages/dockerfile';
  import plaintext from 'highlight.js/lib/languages/plaintext';

  hljs.registerLanguage('bash', bash);
  hljs.registerLanguage('sh', bash);
  hljs.registerLanguage('shell', bash);
  hljs.registerLanguage('javascript', javascript);
  hljs.registerLanguage('js', javascript);
  hljs.registerLanguage('typescript', typescript);
  hljs.registerLanguage('ts', typescript);
  hljs.registerLanguage('json', json);
  hljs.registerLanguage('yaml', yaml);
  hljs.registerLanguage('yml', yaml);
  hljs.registerLanguage('xml', xml);
  hljs.registerLanguage('html', xml);
  hljs.registerLanguage('css', css);
  hljs.registerLanguage('python', python);
  hljs.registerLanguage('py', python);
  hljs.registerLanguage('go', go);
  hljs.registerLanguage('golang', go);
  hljs.registerLanguage('dockerfile', dockerfile);
  hljs.registerLanguage('docker', dockerfile);
  hljs.registerLanguage('plaintext', plaintext);
  hljs.registerLanguage('text', plaintext);

  const MAX_TURNS = 10;
  const SESSION_KEY = 'ask-ai-state';
  const BASE_URL = import.meta.env.PUBLIC_GORDON_BASE_URL || 'https://ai-backend-service-stage.docker.com';

  interface ChatMessage {
    role: 'user' | 'assistant';
    content: string;
    qaId?: string;
    feedback?: 'positive' | 'negative';
  }

  interface SessionState {
    messages: ChatMessage[];
    threadId: string | null;
  }

  function loadState(): SessionState {
    try {
      const raw = sessionStorage.getItem(SESSION_KEY);
      if (raw) return JSON.parse(raw);
    } catch {}
    return { messages: [], threadId: null };
  }

  function saveState(state: SessionState) {
    try {
      sessionStorage.setItem(SESSION_KEY, JSON.stringify(state));
    } catch {}
  }

  let state = loadState();

  const messagesEl = document.getElementById('ask-ai-messages')!;
  const welcomeEl = document.getElementById('ask-ai-welcome')!;
  const inputForm = document.getElementById('ask-ai-input-form') as HTMLFormElement;
  const inputEl = document.getElementById('ask-ai-input') as HTMLTextAreaElement;
  const closeBtn = document.getElementById('ask-ai-close-btn')!;
  const clearBtn = document.getElementById('ask-ai-clear-btn')!;
  const turnsWarning = document.getElementById('ask-ai-turns-warning')!;
  const suggestionsEl = document.getElementById('ask-ai-suggestions')!;

  let isStreaming = false;
  let abortController: AbortController | null = null;

  function getSessionId(): string {
    let id = sessionStorage.getItem('ask-ai-session-id');
    if (!id) {
      id = `docs-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
      sessionStorage.setItem('ask-ai-session-id', id);
    }
    return id;
  }

  // ── Markdown config ──
  marked.use({
    breaks: true,
    gfm: true,
    renderer: {
      code({ text, lang }: { text: string; lang?: string }) {
        const language = lang && hljs.getLanguage(lang) ? lang : null;
        const highlighted = language
          ? hljs.highlight(text, { language }).value
          : hljs.highlightAuto(text).value;
        const langLabel = language || '';
        return `<pre>${langLabel ? `<span class="code-lang">${langLabel}</span>` : ''}<button class="code-copy" aria-label="Copy code">[copy]</button><code class="hljs">${highlighted}</code></pre>`;
      },
    },
  });

  // ── Code block copy buttons (delegated) ──
  messagesEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.code-copy') as HTMLButtonElement | null;
    if (!btn) return;
    const code = btn.closest('pre')?.querySelector('code');
    if (!code) return;
    navigator.clipboard.writeText(code.textContent || '').then(() => {
      btn.textContent = '[ok]';
      setTimeout(() => (btn.textContent = '[copy]'), 1500);
    });
  });

  // ── Panel toggle ──
  function isOpen() {
    return document.documentElement.hasAttribute('data-chat-open');
  }

  function openPanel() {
    document.documentElement.setAttribute('data-chat-open', '');
    // visibility/display transition must complete before input can receive focus
    setTimeout(() => inputEl.focus(), 260);
  }

  function closePanel() {
    document.documentElement.removeAttribute('data-chat-open');
  }

  function togglePanel() {
    if (isOpen()) {
      closePanel();
    } else {
      openPanel();
    }
  }

  window.addEventListener('toggle-ask-ai', togglePanel);

  closeBtn.addEventListener('click', closePanel);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      closePanel();
    }
  });

  // ── Clear chat ──
  clearBtn.addEventListener('click', () => {
    if (isStreaming && abortController) {
      abortController.abort();
      isStreaming = false;
    }
    state = { messages: [], threadId: null };
    saveState(state);
    renderMessages();
  });

  // ── Turns warning ──
  function updateTurnsWarning() {
    const userTurns = state.messages.filter((m) => m.role === 'user').length;
    if (userTurns >= MAX_TURNS) {
      turnsWarning.textContent = 'Turn limit reached. Clear the chat to continue.';
      turnsWarning.style.display = 'block';
      inputEl.disabled = true;
    } else if (userTurns >= MAX_TURNS - 2) {
      turnsWarning.textContent = `${MAX_TURNS - userTurns} turn${MAX_TURNS - userTurns === 1 ? '' : 's'} remaining`;
      turnsWarning.style.display = 'block';
      inputEl.disabled = false;
    } else {
      turnsWarning.style.display = 'none';
      inputEl.disabled = false;
    }
  }

  // ── Render messages ──
  function renderMessages() {
    const existing = messagesEl.querySelectorAll('.ask-ai-msg');
    existing.forEach((el) => el.remove());

    if (state.messages.length === 0) {
      welcomeEl.style.display = '';
    } else {
      welcomeEl.style.display = 'none';
      for (const msg of state.messages) {
        appendMessageEl(msg);
      }
    }
    updateTurnsWarning();
    scrollToBottom();
  }

  function appendMessageEl(msg: ChatMessage): HTMLDivElement {
    const div = document.createElement('div');
    div.className = `ask-ai-msg ask-ai-msg-${msg.role}`;

    if (msg.role === 'user') {
      div.innerHTML = `<span class="ask-ai-user-prompt">$ </span>${escapeHtml(msg.content).replace(/\n/g, '<br>')}`;
    } else {
      const contentDiv = document.createElement('div');
      contentDiv.className = 'ask-ai-assistant-content';
      contentDiv.innerHTML = marked.parse(msg.content) as string;
      div.appendChild(contentDiv);

      // Action buttons
      if (msg.content && msg.qaId) {
        const actions = document.createElement('div');
        actions.className = 'ask-ai-msg-actions';

        const upBtn = document.createElement('button');
        upBtn.className = `ask-ai-btn ask-ai-feedback-btn${msg.feedback === 'positive' ? ' active' : ''}`;
        upBtn.textContent = '[+]';
        upBtn.title = 'Helpful';
        upBtn.addEventListener('click', () => sendFeedback(msg, 'positive', upBtn, downBtn));

        const downBtn = document.createElement('button');
        downBtn.className = `ask-ai-btn ask-ai-feedback-btn ask-ai-feedback-neg${msg.feedback === 'negative' ? ' active' : ''}`;
        downBtn.textContent = '[-]';
        downBtn.title = 'Not helpful';
        downBtn.addEventListener('click', () => sendFeedback(msg, 'negative', upBtn, downBtn));

        const copyBtn = document.createElement('button');
        copyBtn.className = 'ask-ai-btn';
        copyBtn.textContent = '[copy]';
        copyBtn.title = 'Copy to clipboard';
        copyBtn.addEventListener('click', () => {
          navigator.clipboard.writeText(msg.content).then(() => {
            copyBtn.textContent = '[ok]';
            setTimeout(() => (copyBtn.textContent = '[copy]'), 1500);
          });
        });

        actions.appendChild(upBtn);
        actions.appendChild(downBtn);
        actions.appendChild(copyBtn);
        div.appendChild(actions);
      }
    }

    // Insert before the turns warning (keeps form at the end)
    messagesEl.insertBefore(div, turnsWarning);
    return div;
  }

  function escapeHtml(str: string): string {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  // ── Suggestions ──
  suggestionsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.ask-ai-suggestion');
    if (btn) {
      sendMessage((btn as HTMLElement).getAttribute('data-query') || (btn as HTMLElement).textContent!.trim());
    }
  });

  // ── Auto-resize textarea ──
  function autoResize() {
    inputEl.style.height = 'auto';
    inputEl.style.height = inputEl.scrollHeight + 'px';
  }

  inputEl.addEventListener('input', autoResize);

  // ── Enter to submit, Shift+Enter for newline ──
  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      const text = inputEl.value.trim();
      if (!text || isStreaming) return;
      sendMessage(text);
    }
  });

  // ── Form submit (fallback) ──
  inputForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = inputEl.value.trim();
    if (!text || isStreaming) return;
    sendMessage(text);
  });

  // ── Send message ──
  async function sendMessage(content: string) {
    const userTurns = state.messages.filter((m) => m.role === 'user').length;
    if (userTurns >= MAX_TURNS) return;

    // Add user message
    const userMsg: ChatMessage = { role: 'user', content };
    state.messages.push(userMsg);
    saveState(state);

    welcomeEl.style.display = 'none';
    appendMessageEl(userMsg);
    inputEl.value = '';
    inputEl.style.height = 'auto';
    updateTurnsWarning();
    scrollToBottom();

    // Build API messages
    const apiMessages = state.messages.map((m, i, arr) => {
        const base: any = { role: m.role, content: m.content };
        if (m.role === 'user' && i === arr.length - 1) {
          base.copilot_references = [
            {
              data: {
                origin: 'kaname-docs',
                email: 'docs@docker.com',
                uuid: getSessionId(),
                action: 'AskGordon',
                page_url: window.location.href,
                page_title: document.title,
              },
            },
          ];
        }
        return base;
      });

    // Stream response
    const assistantMsg: ChatMessage = { role: 'assistant', content: '' };
    state.messages.push(assistantMsg);

    const assistantDiv = appendMessageEl(assistantMsg);
    const contentDiv = assistantDiv.querySelector('.ask-ai-assistant-content')!;
    assistantDiv.classList.add('streaming');

    isStreaming = true;
    inputEl.disabled = true;
    abortController = new AbortController();

    // ASCII spinner until first token
    const spinFrames = ['/', '-', '\\', '|'];
    let spinIdx = 0;
    let gotFirstToken = false;
    contentDiv.textContent = spinFrames[0];
    const spinTimer = setInterval(() => {
      spinIdx = (spinIdx + 1) % spinFrames.length;
      contentDiv.textContent = spinFrames[spinIdx];
    }, 120);

    try {
      const body: any = { messages: apiMessages };
      if (state.threadId) body.thread_uuid = state.threadId;

      const resp = await fetch(`${BASE_URL}/public/ask`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal: abortController.signal,
      });

      if (!resp.ok) {
        clearInterval(spinTimer);
        assistantMsg.content = 'Sorry, something went wrong. Please try again.';
        contentDiv.textContent = assistantMsg.content;
        saveState(state);
        isStreaming = false;
        inputEl.disabled = false;
        return;
      }

      const reader = resp.body!.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (!line.startsWith('data: ')) continue;
          const data = line.slice(6).trim();
          if (data === '[DONE]') continue;

          try {
            const parsed = JSON.parse(data);

            if (parsed.thread_id) {
              state.threadId = parsed.thread_id;
            }

            if (parsed.question_answer_id) {
              assistantMsg.qaId = parsed.question_answer_id;
            }

            if (parsed.choices?.[0]?.delta?.content) {
              if (!gotFirstToken) {
                clearInterval(spinTimer);
                gotFirstToken = true;
              }
              assistantMsg.content += parsed.choices[0].delta.content;
              contentDiv.innerHTML = marked.parse(assistantMsg.content) as string;
              scrollToBottom();
            }
          } catch {}
        }
      }
    } catch (err: any) {
      clearInterval(spinTimer);
      if (err.name === 'AbortError') {
        // Aborted intentionally
      } else {
        assistantMsg.content = assistantMsg.content || 'Connection error. Please try again.';
        contentDiv.innerHTML = marked.parse(assistantMsg.content) as string;
      }
    }

    isStreaming = false;
    inputEl.disabled = false;
    abortController = null;
    saveState(state);
    assistantDiv.classList.remove('streaming');

    // Re-render to get action buttons
    renderMessages();
  }

  // ── Feedback ──
  async function sendFeedback(
    msg: ChatMessage,
    feedback: 'positive' | 'negative',
    upBtn: HTMLButtonElement,
    downBtn: HTMLButtonElement,
  ) {
    if (!msg.qaId) return;

    msg.feedback = feedback;
    saveState(state);

    upBtn.classList.toggle('active', feedback === 'positive');
    downBtn.classList.toggle('active', feedback === 'negative');

    try {
      await fetch(`${BASE_URL}/feedback`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: msg.qaId, feedback }),
      });
    } catch {}
  }

  // ── Restore on load ──
  renderMessages();
</script>

<style>
  /* ── Container — terminal session ── */
  .ask-ai-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    overflow: hidden;
  }

  /* ── Header — terminal title bar ── */
  .ask-ai-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    flex-shrink: 0;
  }

  .ask-ai-title {
    color: #4ade80;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-shadow: 0 0 10px rgba(74, 222, 128, 0.2);
  }

  :global([data-theme='light']) .ask-ai-title {
    color: #16a34a;
    text-shadow: none;
  }

  .ask-ai-header-actions {
    display: flex;
    gap: 0.25rem;
  }

  /* ── Shared button styles ── */
  .ask-ai-btn {
    background: none;
    border: none;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    padding: 0.15rem 0.3rem;
    transition: color 0.15s ease;
  }

  .ask-ai-btn:hover {
    color: #4ade80;
  }

  :global([data-theme='light']) .ask-ai-btn:hover {
    color: #16a34a;
  }

  /* ── Terminal buffer — single scrollable area ── */
  .ask-ai-messages {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 0.75rem;
    min-height: 0;
  }

  /* ── Welcome / MOTD ── */
  .ask-ai-welcome {
    padding: 0.25rem 0 0.75rem;
  }

  .ask-ai-welcome-text {
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
    margin-bottom: 0.75rem;
  }

  /* ── Suggestion comments ── */
  .ask-ai-suggestions {
    display: flex;
    flex-direction: column;
  }

  .ask-ai-suggestion {
    background: none;
    border: none;
    color: var(--sl-color-gray-4);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    padding: 0.1rem 0;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s ease;
  }

  .ask-ai-suggestion:hover {
    color: #4ade80;
  }

  :global([data-theme='light']) .ask-ai-suggestion:hover {
    color: #16a34a;
  }

  /* ── Dynamic elements (created via JS, no Astro scope attr) ──
     All selectors anchored through .ask-ai-messages (in template)
     with :global() on the dynamic classes. ── */

  /* Messages */
  .ask-ai-messages :global(.ask-ai-msg) {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  /* User command */
  .ask-ai-messages :global(.ask-ai-msg-user) {
    color: var(--sl-color-gray-1);
    font-size: 0.82rem;
  }

  .ask-ai-messages :global(.ask-ai-user-prompt) {
    color: #4ade80;
    font-weight: 600;
  }

  :global([data-theme='light']) .ask-ai-messages :global(.ask-ai-user-prompt) {
    color: #16a34a;
  }

  /* ── Assistant output — prose rendering ── */
  .ask-ai-messages :global(.ask-ai-msg-assistant) {
    padding-left: 0.75rem;
    border-left: 2px solid rgba(74, 222, 128, 0.12);
  }

  :global([data-theme='light']) .ask-ai-messages :global(.ask-ai-msg-assistant) {
    border-left-color: rgba(22, 163, 74, 0.15);
  }

  .ask-ai-messages :global(.ask-ai-assistant-content) {
    /* Break out of monospace — use the same proportional font as main content */
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: var(--sl-color-gray-2);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  /* ── Streaming cursor ── */
  .ask-ai-messages :global(.ask-ai-msg-assistant.streaming .ask-ai-assistant-content)::after {
    content: '\2588';
    font-family: var(--sl-font-mono);
    color: #4ade80;
    animation: cursor-blink 1s step-end infinite;
    margin-left: 2px;
    font-size: 0.8em;
  }

  :global([data-theme='light']) .ask-ai-messages :global(.ask-ai-msg-assistant.streaming .ask-ai-assistant-content)::after {
    color: #16a34a;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── Prose: headings ── */
  .ask-ai-messages :global(.ask-ai-assistant-content h1),
  .ask-ai-messages :global(.ask-ai-assistant-content h2),
  .ask-ai-messages :global(.ask-ai-assistant-content h3),
  .ask-ai-messages :global(.ask-ai-assistant-content h4) {
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: 1.35;
    margin: 1.25em 0 0.35em;
  }

  .ask-ai-messages :global(.ask-ai-assistant-content :first-child:is(h1, h2, h3, h4)) {
    margin-top: 0;
  }

  .ask-ai-messages :global(.ask-ai-assistant-content h1) { font-size: 1.15em; }
  .ask-ai-messages :global(.ask-ai-assistant-content h2) { font-size: 1.05em; }
  .ask-ai-messages :global(.ask-ai-assistant-content h3) { font-size: 0.95em; }
  .ask-ai-messages :global(.ask-ai-assistant-content h4) { font-size: 0.88em; color: var(--sl-color-gray-2); }

  /* ── Prose: paragraphs ── */
  .ask-ai-messages :global(.ask-ai-assistant-content p) {
    margin: 0.6em 0;
  }

  .ask-ai-messages :global(.ask-ai-assistant-content p:first-child) { margin-top: 0; }
  .ask-ai-messages :global(.ask-ai-assistant-content p:last-child) { margin-bottom: 0; }

  /* ── Prose: inline code (stays monospace) ── */
  .ask-ai-messages :global(.ask-ai-assistant-content code) {
    font-family: var(--sl-font-mono);
    background: var(--sl-color-bg-inline-code);
    padding: 0.15em 0.35em;
    font-size: 0.85em;
    border-radius: 0;
  }

  /* ── Prose: code blocks (monospace, highlighted) ── */
  .ask-ai-messages :global(.ask-ai-assistant-content pre) {
    font-family: var(--sl-font-mono);
    background: rgba(0, 0, 0, 0.3);
    padding: 0.7rem 0.85rem;
    margin: 0.75em 0;
    overflow-x: auto;
    border-radius: 0;
    font-size: 0.78rem;
    line-height: 1.6;
    border-left: 2px solid rgba(74, 222, 128, 0.15);
    position: relative;
  }

  :global([data-theme='light']) .ask-ai-messages :global(.ask-ai-assistant-content pre) {
    background: rgba(0, 0, 0, 0.035);
    border-left-color: rgba(22, 163, 74, 0.2);
  }

  .ask-ai-messages :global(.ask-ai-assistant-content pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  /* Language label */
  .ask-ai-messages :global(.ask-ai-assistant-content pre:has(.code-lang)) {
    padding-top: 1.8rem;
  }

  .ask-ai-messages :global(.ask-ai-assistant-content .code-lang) {
    position: absolute;
    top: 0.35rem;
    left: 0.55rem;
    font-size: 0.7em;
    color: var(--sl-color-gray-4);
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

